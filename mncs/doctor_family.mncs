mncs 0.19;
module doctor.family.v1;

// Freeze root for the production Doctor policy family. The wrappers keep
// every imported policy module live in one artifact; callers still target the
// imported doctor.* module identities, not these probe functions.
use doctor.discovery.v1 as discovery;
use doctor.edits.v1 as edits;
use doctor.architecture.v1 as architecture;
use doctor.fix.v1 as fix;
use doctor.health.v1 as health;
use doctor.migration.v1 as migration;
use doctor.report.v1 as report;
use doctor.remediate.v1 as remediate;
use doctor.scanner.v1 as scanner;
use doctor.transaction.v1 as transaction;
use doctor.verify.v1 as verify;
use doctor.verify_process.v1 as verify_process;
use doctor.version.v1 as version;

fn discovery_code() -> (result: discovery.FileClass) {
    let filename: discovery.TextView = discovery.TextView {
        bytes: [99, 97, 110, 100, 105, 100, 97, 116, 101, 46, 109, 110, 99, 115],
        length: 14,
    };
    let extension: discovery.TextView = discovery.TextView {
        bytes: [109, 110, 99, 115],
        length: 4,
    };
    let name: discovery.NameView = discovery.NameView {
        prefix: filename,
        suffix: filename,
    };
    return discovery.file_class(discovery.FileClassInput {
        name: name,
        extension: extension,
    });
}

fn edits_code() -> (result: edits.ConflictVerdict) {
    return edits.pair_conflict(edits.PairConflictInput {
        a_start: 1,
        a_end: 4,
        b_start: 3,
        b_end: 6,
    });
}

fn fix_code() -> (result: fix.MergeVerdict) {
    return fix.merge_verdict(fix.MergeInput { conflicts: 0 });
}

fn health_code() -> (result: health.Status) {
    return health.combine(health.Status.Warning, health.Status.Fail);
}

fn migration_code() -> (result: migration.MigrationVerdict) {
    let kinds: [migration.TransitionKind; 16] = [migration.TransitionKind.Noop; 16];
    return migration.plan_verdict(migration.PlanInput {
        from_minor: 8,
        to_minor: 16,
        kinds: kinds,
        count: 0,
    });
}

fn report_code() -> (result: report.ExitDecision) {
    return report.exit_for(report.ExitInput {
        worst: health.Status.Warning,
        review_blocked: false,
        verified: false,
        verify_passed: true,
    });
}

fn remediation_repair_code() -> (result: remediate.RemediationClass) {
    return remediate.classify_repair(0, true);
}

fn remediation_stop_code() -> (result: remediate.StopDisposition) {
    return remediate.classify_stop(0, true);
}

fn remediation_residual_code() -> (result: remediate.ResidualDisposition) {
    return remediate.classify_residual(0);
}

fn scanner_code() -> (result: [u64; 6]) {
    let bytes: [byte; 1] = [10];
    let state: [u64; 6] = [0; 6];
    return scanner.feed(bytes, state);
}

fn transaction_code() -> (result: transaction.TransactionTargetVerdict) {
    return transaction.validate_target(transaction.TransactionTargetInput {
        expected_present: true,
        actual_present: true,
        is_symlink: false,
        is_file: true,
        fingerprint_matches: true,
        identical: false,
    });
}

fn verify_code() -> (result: verify.VerificationVerdict) {
    return verify.compose(verify.ComposeInput {
        delta: verify.VerificationVerdict.Pass,
        idempotent: true,
        external_pass: true,
    });
}

fn verify_process_code() -> (result: verify_process.ProcessVerdict) {
    return verify_process.classify_process_verdict(verify_process.StatusInput {
        exit_code: 0,
        has_exit_code: true,
        success: true,
        timed_out: false
    });
}

fn version_code() -> (result: version.VersionClass) {
    return version.classify(version.VersionInput {
        major: 0,
        minor: 16,
        current_major: 0,
        current_minor: 16,
    });
}

fn architecture_code() -> (result: [u64; 6]) {
    let empty_text64: architecture.Text64 = architecture.Text64 {
        bytes: [0; 64],
        length: 0,
        present: false,
    };
    let empty_text128: architecture.Text128 = architecture.Text128 {
        bytes: [0; 128],
        length: 0,
        present: false,
    };
    let model: architecture.ModelDecision = architecture.check_model(
        architecture.ModelInput {
            schema: empty_text64,
            content_identity: empty_text128,
        },
    );
    let header: architecture.ClaimsHeaderDecision = architecture.check_claims_header(
        architecture.ClaimsHeaderInput {
            schema: empty_text64,
            architecture_claim: empty_text128,
            model_identity: empty_text128,
            language_claim: empty_text128,
            language_identity: empty_text128,
            profile_claim: empty_text128,
            language_profile: empty_text128,
        },
    );
    let no_capabilities: [architecture.ModelCapability; up_to 64] = [];
    let capability: architecture.CapabilityDecision = architecture.check_capability(
        architecture.CapabilityInput {
            claim_id: empty_text64,
            claim_canonical_path: empty_text64,
            claim_shadow_path: empty_text64,
            claim_shadow_state: empty_text64,
            model_capabilities: no_capabilities,
            root_available: false,
            canonical_path_exists: false,
        },
    );
    let no_contracts: [architecture.Text64; up_to 64] = [];
    let contract: architecture.ContractDecision = architecture.check_contract(
        architecture.ContractInput {
            claim: empty_text64,
            model_contracts: no_contracts,
        },
    );
    return [
        model.schema_supported as u64,
        model.content_identity_valid as u64,
        model.value_too_long as u64,
        header.schema_supported as u64,
        capability.found as u64,
        contract.resolved as u64,
    ];
}
