mncs 0.16;
module doctor.fix.v1;

// doctor.fix — repair orchestration *policy* in MNCS.
//
// Boundary: provider execution (text scanning, edit construction) and
// backend diagnosis stay host-side; upstream semantic fixes belong to
// mncs-language (DOC-P-002). What lives here is the decision procedure:
// eligibility gating, per-round merge verdicts, and the fixed-point
// stopping rule. The host loop calls these entrypoints once per round
// with scalar state, so iteration itself needs no MNCS heap.
//
// Applicability remains an external provider fact. Semantic applicability,
// merge, and seen-provider decisions use nominal values at the boundary.

enum Applicability { Safe, SemanticallyProven, Review, Manual }
enum MergeVerdict { Keep, Skip }
enum SeenVerdict { Fresh, Seen }

record EligibilityInput {
    level: Applicability,
    allow_safe: bool,
    allow_proven: bool
}

record MergeInput { conflicts: u64 }

record SeenBeforeInput {
    fired: [u64; 8],
    count: u64,
    id: u64
}

// Eligibility gate: safe always (when enabled), proven only with opt-in,
// review/manual never automatic.
fn eligible(input: EligibilityInput) -> (result: bool) {
    return match input.level {
        Safe => input.allow_safe,
        SemanticallyProven => input.allow_proven,
        Review => false,
        Manual => false,
    };
}

// Merge verdict for one candidate fix against the kept set. A conflicting
// fix is recorded and skipped, never fatal to the surviving plan.
fn merge_verdict(input: MergeInput) -> (result: MergeVerdict) {
    if input.conflicts > 0 {
        return MergeVerdict.Skip;
    }
    return MergeVerdict.Keep;
}

enum StopDecision { Continue, Fixpoint, BudgetExhausted, Oscillation }

record StopRuleInput {
    planned_empty: bool,
    fired_before: bool,
    iterations: u64,
    budget: u64,
}

// Fixed-point stopping rule. `planned_empty` means this round produced no
// applicable fixes; `fired_before` means a provider in this round already
// fired on an earlier round (non-idempotent or oscillating pair);
// `iterations` counts applied rounds against `budget`.
fn stop_rule(input: StopRuleInput) -> (result: StopDecision) {
    if input.planned_empty {
        return StopDecision.Fixpoint;
    }
    if input.fired_before {
        return StopDecision.Oscillation;
    }
    if input.iterations >= input.budget {
        return StopDecision.BudgetExhausted;
    }
    return StopDecision.Continue;
}

// Provider-seen check over a packed window of previously fired provider
// identities plus a live count.
fn seen_before(input: SeenBeforeInput) -> (result: SeenVerdict) {
    iterate i over input.fired carrying hit: bool = false {
        let live: bool = i < input.count && i < input.fired.len;
        next hit = hit || (live && input.fired[i] == input.id);
    }
    return select(hit, SeenVerdict.Seen, SeenVerdict.Fresh);
}
