mncs 0.16;
module doctor.verify.v1;

// doctor.verify — verification *composition policy* in MNCS.
//
// Re-diagnosis execution and external process spawning stay host-side. The
// evidence-composition verdict is a nominal finite value at the boundary.

enum VerificationVerdict { Pass, Fail }

record DeltaInput {
    errors_before: u64,
    errors_after: u64
}

record ComposeInput {
    delta: VerificationVerdict,
    idempotent: bool,
    external_pass: bool
}

// Error-delta verdict: passing means no NEW errors appeared.
fn delta_ok(input: DeltaInput) -> (result: VerificationVerdict) {
    if input.errors_after <= input.errors_before {
        return VerificationVerdict.Pass;
    }
    return VerificationVerdict.Fail;
}

// Every evidence channel must pass.
fn compose(input: ComposeInput) -> (result: VerificationVerdict) {
    let delta_pass: bool = match input.delta {
        Pass => true,
        Fail => false,
    };
    if delta_pass && input.idempotent && input.external_pass {
        return VerificationVerdict.Pass;
    }
    return VerificationVerdict.Fail;
}
