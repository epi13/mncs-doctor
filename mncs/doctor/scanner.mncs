mncs 0.16;
module doctor.scanner.v1;

// doctor.scanner — bounded byte-ingress policy for source hygiene.
//
// The host reads arbitrary bytes and feeds them in up-to-64-byte windows.
// The carried six-cell state is:
//   0 BOM prefix progress, 1 BOM found,
//   2 bare LF count, 3 CRLF count, 4 bare CR count, 5 pending CR.
// Counts are evidence for newline classification; the host may saturate or
// widen them when it needs a larger file-level accounting domain.

fn feed(bytes: [byte; up_to 64], state: [u64; 6]) -> (result: [u64; 6]) {
    iterate i over bytes carrying next_state: [u64; 6] = state {
        let b: byte = bytes[i];
        let prior_cr: bool = next_state[5] == 1;
        let is_cr: bool = b == 13;
        let is_lf: bool = b == 10;
        let bare_lf: u64 = (is_lf && !prior_cr) as u64;
        let crlf: u64 = (is_lf && prior_cr) as u64;
        let bare_cr: u64 = (prior_cr && !is_lf) as u64;
        let next_bom: u64 = select(
            next_state[0] == 0 && b == 239,
            1,
            select(
                next_state[0] == 1 && b == 187,
                2,
                select(
                    next_state[0] == 2 && b == 191,
                    3,
                    select(next_state[0] < 3, 4, next_state[0])
                )
            )
        );
        let with_bom: [u64; 6] = replace(next_state, 0, next_bom);
        let with_bom: [u64; 6] = replace(with_bom, 1, select(next_bom == 3, 1, with_bom[1]));
        let with_lf: [u64; 6] = replace(with_bom, 2, with_bom[2] + bare_lf);
        let with_crlf: [u64; 6] = replace(with_lf, 3, with_lf[3] + crlf);
        let with_bare_cr: [u64; 6] = replace(with_crlf, 4, with_crlf[4] + bare_cr);
        next next_state = replace(with_bare_cr, 5, is_cr as u64);
    }
    return next_state;
}

// Flush a trailing CR at end-of-input. A CR followed by LF is counted by
// `feed`; only an unpaired final CR remains pending here.
fn finish(state: [u64; 6]) -> (result: [u64; 6]) {
    let with_cr: [u64; 6] = replace(state, 4, state[4] + (state[5] == 1) as u64);
    return replace(with_cr, 5, 0);
}

// Source-header and module declaration recognition is a deliberately shallow
// Doctor hygiene rule. It does not parse MNCS syntax or infer a semantic
// profile. The host streams valid UTF-8 bytes in the same bounded windows as
// the delimiter scanner; candidate and line state survive every boundary.
record HeaderScanState {
    position: u64,
    mode: byte,
    slash_position: u64,
    candidate_start: u64,
    token_stage: byte,
    first_token_length: u64,
    first_token_matches: bool,
    version_seen: bool,
    version_valid: bool,
    version_component: byte,
    version_digits: u64,
    version_plus: bool,
    version_major: u64,
    version_minor: u64,
    header_present: bool,
    header_valid: bool,
    header_major: u64,
    header_minor: u64,
    header_start: u64,
    header_end: u64,
    module_prefix_length: byte,
    module_prefix_invalid: bool,
    module_last_nonwhite: u64,
    module_seen: bool,
    utf8_remaining: byte,
    utf8_codepoint: u64
}

record HeaderScanResult {
    header_present: bool,
    version_valid: bool,
    major: u64,
    minor: u64,
    start: u64,
    end: u64,
    module_decl_present: bool
}

// Combined source ingress carries both existing BOM/newline facts and the
// Doctor hygiene header state through one bounded call per input window.
record ScannerStreamState {
    byte_state: [u64; 6],
    header_state: HeaderScanState
}

record ScannerStreamResult {
    byte_state: [u64; 6],
    newline_style: ScannerNewlineStyle,
    header_result: HeaderScanResult
}

enum ScannerNewlineStyle { None, Lf, Crlf, Mixed }

// The scanner owns newline-style classification. A CR-only file retains
// Doctor's existing `none` result; bare CR contributes to `mixed` only when
// another recognized line-ending form is present.
fn classify_newline(state: [u64; 6]) -> (result: ScannerNewlineStyle) {
    let styles: u64 = ((state[2] > 0) as u64) + ((state[3] > 0) as u64) + ((state[4] > 0) as u64);
    if styles == 0 { return ScannerNewlineStyle.None; }
    if styles > 1 { return ScannerNewlineStyle.Mixed; }
    if state[3] > 0 { return ScannerNewlineStyle.Crlf; }
    if state[2] > 0 { return ScannerNewlineStyle.Lf; }
    return ScannerNewlineStyle.None;
}

fn header_init() -> (result: HeaderScanState) {
    return HeaderScanState {
        position: 0,
        mode: 0,
        slash_position: 0,
        candidate_start: 0,
        token_stage: 0,
        first_token_length: 0,
        first_token_matches: false,
        version_seen: false,
        version_valid: false,
        version_component: 0,
        version_digits: 0,
        version_plus: false,
        version_major: 0,
        version_minor: 0,
        header_present: false,
        header_valid: false,
        header_major: 0,
        header_minor: 0,
        header_start: 0,
        header_end: 0,
        module_prefix_length: 0,
        module_prefix_invalid: false,
        module_last_nonwhite: 0,
        module_seen: false,
        utf8_remaining: 0,
        utf8_codepoint: 0
    };
}

fn is_ascii_space(value: byte) -> (result: bool) {
    return value == 9 || value == 10 || value == 11 || value == 12 || value == 13 || value == 32;
}

// Match Rust char::is_whitespace for the UTF-8 source text accepted by the
// host boundary. The byte scanner validates no language syntax; it only needs
// the same Unicode trim/split behavior as the former shallow host rule.
fn is_unicode_space(value: u64) -> (result: bool) {
    return (value >= 9 && value <= 13) || value == 32 || value == 133 || value == 160
        || value == 5760 || (value >= 8192 && value <= 8202) || value == 8232
        || value == 8233 || value == 8239 || value == 8287 || value == 12288;
}

fn module_prefix_char(index: u64) -> (result: u64) {
    if index == 0 { return 109; }
    if index == 1 { return 111; }
    if index == 2 { return 100; }
    if index == 3 { return 117; }
    if index == 4 { return 108; }
    if index == 5 { return 101; }
    return 32;
}

fn module_line_feed(state: HeaderScanState, value: u64) -> (result: HeaderScanState) {
    if value == 10 {
        let found: bool = state.module_prefix_length == 7
            && !state.module_prefix_invalid && state.module_last_nonwhite == 59;
        return HeaderScanState {
            ..state,
            module_prefix_length: 0,
            module_prefix_invalid: false,
            module_last_nonwhite: 0,
            module_seen: state.module_seen || found
        };
    }
    let whitespace: bool = is_unicode_space(value);
    let prefix_length: u64 = state.module_prefix_length as u64;
    if prefix_length == 0 {
        if whitespace { return state; }
        if value == module_prefix_char(0) {
            return HeaderScanState { ..state, module_prefix_length: 1, module_last_nonwhite: value };
        }
        return HeaderScanState { ..state, module_prefix_invalid: true, module_last_nonwhite: value };
    }
    if state.module_prefix_invalid { return state; }
    if prefix_length < 7 {
        if value == module_prefix_char(prefix_length) {
            let next_length: byte = (prefix_length + 1) as byte;
            return HeaderScanState {
                ..state,
                module_prefix_length: next_length,
                module_last_nonwhite: select(whitespace, state.module_last_nonwhite, value)
            };
        }
        return HeaderScanState {
            ..state,
            module_prefix_invalid: true,
            module_last_nonwhite: select(whitespace, state.module_last_nonwhite, value)
        };
    }
    if whitespace { return state; }
    return HeaderScanState { ..state, module_last_nonwhite: value };
}

fn header_begin_candidate(state: HeaderScanState, start: u64) -> (result: HeaderScanState) {
    return HeaderScanState {
        ..state,
        mode: 5,
        candidate_start: start,
        token_stage: 0,
        first_token_length: 0,
        first_token_matches: true,
        version_seen: false,
        version_valid: true,
        version_component: 0,
        version_digits: 0,
        version_plus: false,
        version_major: 0,
        version_minor: 0
    };
}

fn header_version_char(state: HeaderScanState, value: u64) -> (result: HeaderScanState) {
    if value == 46 {
        if state.version_component == 0 && state.version_digits > 0 {
            return HeaderScanState {
                ..state,
                version_component: 1,
                version_digits: 0,
                version_plus: false
            };
        }
        return HeaderScanState { ..state, version_valid: false };
    }
    if value == 43 {
        if state.version_digits == 0 && !state.version_plus {
            return HeaderScanState { ..state, version_plus: true };
        }
        return HeaderScanState { ..state, version_valid: false };
    }
    if value >= 48 && value <= 57 {
        let digit: u64 = value - 48;
        let current: u64 = select(state.version_component == 0, state.version_major, state.version_minor);
        if current > 429496729 || (current == 429496729 && digit > 5) {
            return HeaderScanState { ..state, version_valid: false, version_digits: state.version_digits + 1 };
        }
        let next_value: u64 = current *% 10 +% digit;
        if state.version_component == 0 {
            return HeaderScanState {
                ..state,
                version_major: next_value,
                version_digits: state.version_digits + 1
            };
        }
        return HeaderScanState {
            ..state,
            version_minor: next_value,
            version_digits: state.version_digits + 1
        };
    }
    return HeaderScanState { ..state, version_valid: false };
}

fn header_finish_candidate(state: HeaderScanState, end: u64) -> (result: HeaderScanState) {
    let present: bool = state.first_token_length == 4 && state.first_token_matches && state.version_seen;
    let valid: bool = present && state.version_valid && state.version_component == 1 && state.version_digits > 0;
    return HeaderScanState {
        ..state,
        mode: 6,
        header_present: present,
        header_valid: valid,
        header_major: state.version_major,
        header_minor: state.version_minor,
        header_start: state.candidate_start,
        header_end: end
    };
}

fn header_candidate_char(state: HeaderScanState, value: u64, start: u64) -> (result: HeaderScanState) {
    if value == 10 { return HeaderScanState { ..state, mode: 6 }; }
    if value == 59 { return header_finish_candidate(state, start + 1); }
    if is_unicode_space(value) {
        if state.token_stage == 0 && state.first_token_length > 0 {
            return HeaderScanState { ..state, token_stage: 1 };
        }
        if state.token_stage == 2 { return HeaderScanState { ..state, token_stage: 3 }; }
        return state;
    }
    if state.token_stage == 0 {
        let expected: u64 = select(
            state.first_token_length == 0, 109,
            select(state.first_token_length == 1, 110,
                select(state.first_token_length == 2, 99,
                    select(state.first_token_length == 3, 115, 0)))
        );
        return HeaderScanState {
            ..state,
            first_token_matches: state.first_token_matches && state.first_token_length < 4 && value == expected,
            first_token_length: select(state.first_token_length < 5, state.first_token_length + 1, 5)
        };
    }
    if state.token_stage == 1 {
        let begun: HeaderScanState = HeaderScanState { ..state, token_stage: 2, version_seen: true };
        return header_version_char(begun, value);
    }
    if state.token_stage == 2 { return header_version_char(state, value); }
    return state;
}

fn header_head_byte(state: HeaderScanState, value: byte) -> (result: HeaderScanState) {
    let position: u64 = state.position;
    if state.mode == 0 {
        if is_ascii_space(value) { return state; }
        if value == 47 { return HeaderScanState { ..state, mode: 1, slash_position: position }; }
        let begun: HeaderScanState = header_begin_candidate(state, position);
        if (value as u64) < 128 { return header_candidate_char(begun, value as u64, position); }
        return begun;
    }
    if state.mode == 1 {
        if value == 47 { return HeaderScanState { ..state, mode: 2 }; }
        if value == 42 { return HeaderScanState { ..state, mode: 3 }; }
        let begun: HeaderScanState = header_begin_candidate(state, state.slash_position);
        let with_slash: HeaderScanState = header_candidate_char(begun, 47, state.slash_position);
        if (value as u64) < 128 { return header_candidate_char(with_slash, value as u64, position); }
        return with_slash;
    }
    if state.mode == 2 {
        if value == 10 { return HeaderScanState { ..state, mode: 0 }; }
        return state;
    }
    if state.mode == 3 {
        if value == 42 { return HeaderScanState { ..state, mode: 4 }; }
        return state;
    }
    if state.mode == 4 {
        if value == 47 { return HeaderScanState { ..state, mode: 0 }; }
        if value == 42 { return state; }
        return HeaderScanState { ..state, mode: 3 };
    }
    if state.mode == 5 && (value as u64) < 128 {
        return header_candidate_char(state, value as u64, position);
    }
    return state;
}

fn header_unicode_char(state: HeaderScanState, value: u64) -> (result: HeaderScanState) {
    let with_module: HeaderScanState = module_line_feed(state, value);
    if with_module.mode == 5 { return header_candidate_char(with_module, value, with_module.position); }
    return with_module;
}

fn header_scan_byte(state: HeaderScanState, value: byte) -> (result: HeaderScanState) {
    if state.mode == 6 && state.module_seen { return state; }
    let position: u64 = state.position;
    let headed: HeaderScanState = header_head_byte(state, value);
    if (value as u64) < 128 {
        let advanced: HeaderScanState = module_line_feed(headed, value as u64);
        return HeaderScanState { ..advanced, position: position + 1 };
    }
    if headed.utf8_remaining == 0 {
        if value >= 194 && value <= 223 {
            return HeaderScanState { ..headed, position: position + 1, utf8_remaining: 1, utf8_codepoint: (value as u64) % 32 };
        }
        if value >= 224 && value <= 239 {
            return HeaderScanState { ..headed, position: position + 1, utf8_remaining: 2, utf8_codepoint: (value as u64) % 16 };
        }
        if value >= 240 && value <= 244 {
            return HeaderScanState { ..headed, position: position + 1, utf8_remaining: 3, utf8_codepoint: (value as u64) % 8 };
        }
        return HeaderScanState { ..headed, position: position + 1 };
    }
    let codepoint: u64 = headed.utf8_codepoint *% 64 +% ((value as u64) % 64);
    let remaining: byte = ((headed.utf8_remaining as i64) - 1) as byte;
    let pending: HeaderScanState = HeaderScanState { ..headed, utf8_remaining: remaining, utf8_codepoint: codepoint };
    if remaining == 0 {
        let complete: HeaderScanState = header_unicode_char(pending, codepoint);
        return HeaderScanState { ..complete, position: position + 1 };
    }
    return HeaderScanState { ..pending, position: position + 1 };
}

fn header_feed(bytes: [byte; up_to 64], state: HeaderScanState) -> (result: HeaderScanState) {
    iterate i over bytes carrying current: HeaderScanState = state {
        next current = header_scan_byte(current, bytes[i]);
    }
    return current;
}

fn header_finish(state: HeaderScanState) -> (result: HeaderScanResult) {
    let module_found: bool = state.module_prefix_length == 7
        && !state.module_prefix_invalid && state.module_last_nonwhite == 59;
    return HeaderScanResult {
        header_present: state.header_present,
        version_valid: state.header_valid,
        major: state.header_major,
        minor: state.header_minor,
        start: state.header_start,
        end: state.header_end,
        module_decl_present: state.module_seen || module_found
    };
}

fn stream_init() -> (result: ScannerStreamState) {
    return ScannerStreamState {
        byte_state: [0, 0, 0, 0, 0, 0],
        header_state: header_init()
    };
}

fn stream_feed(bytes: [byte; up_to 64], state: ScannerStreamState) -> (result: ScannerStreamState) {
    return ScannerStreamState {
        byte_state: feed(bytes, state.byte_state),
        header_state: header_feed(bytes, state.header_state)
    };
}

fn stream_finish(state: ScannerStreamState) -> (result: ScannerStreamResult) {
    let byte_state: [u64; 6] = finish(state.byte_state);
    return ScannerStreamResult {
        byte_state: byte_state,
        newline_style: classify_newline(byte_state),
        header_result: header_finish(state.header_state)
    };
}

// Delimiter balance is also part of the streaming scanner contract. The
// state carries lexical mode, absolute byte position, and a bounded stack of
// packed (offset * 4 + opener-kind) entries. Capacity exhaustion is a
// separate result: callers must report that the heuristic could not finish,
// never silently treat the file as balanced.
enum DelimiterStatus { Balanced, Unbalanced, CapacityExceeded }

record DelimiterResult { status: DelimiterStatus, offset: u64 }

// State slots 0..7 are mode, string escape, pending slash, pending block
// comment star, stack depth, verdict (0 clear, 1 unbalanced, 2 hard capacity,
// 3 reserved, verdict offset, and absolute byte offset. Slots 8..1,023 hold
// unmatched openers, for a hard bound of 1,016 nested delimiters.
// Kinds are '{' = 1, '(' = 2, '[' = 3.
fn delimiter_push(state: [u64; 1024], kind: u64, offset: u64) -> (result: [u64; 1024]) {
    if offset > 4611686018427387903 {
        let marked: [u64; 1024] = replace(state, 5, 2);
        let positioned: [u64; 1024] = replace(marked, 6, offset);
        return replace(positioned, 7, offset);
    }
    if state[4] >= 1016 {
        let marked: [u64; 1024] = replace(state, 5, 2);
        let positioned: [u64; 1024] = replace(marked, 6, offset);
        return replace(positioned, 7, offset);
    }
    let slot: u64 = 8 + state[4];
    let packed: u64 = offset *% 4 +% kind;
    let stored: [u64; 1024] = replace(state, slot, packed);
    return replace(stored, 4, state[4] + 1);
}

fn delimiter_close(state: [u64; 1024], kind: u64, offset: u64) -> (result: [u64; 1024]) {
    if state[4] == 0 {
        let marked: [u64; 1024] = replace(state, 5, 1);
        return replace(marked, 6, offset);
    }
    let slot: u64 = 8 + state[4] - 1;
    let packed: u64 = state[slot];
    let opener_kind: u64 = packed % 4;
    if opener_kind != kind {
        let marked: [u64; 1024] = replace(state, 5, 1);
        return replace(marked, 6, offset);
    }
    return replace(state, 4, state[4] - 1);
}

fn delimiter_normal_byte(state: [u64; 1024], value: byte, offset: u64) -> (result: [u64; 1024]) {
    if value == 34 {
        return replace(state, 0, 1);
    }
    if value == 47 {
        return replace(state, 2, 1);
    }
    if value == 123 { return delimiter_push(state, 1, offset); }
    if value == 40 { return delimiter_push(state, 2, offset); }
    if value == 91 { return delimiter_push(state, 3, offset); }
    if value == 125 { return delimiter_close(state, 1, offset); }
    if value == 41 { return delimiter_close(state, 2, offset); }
    if value == 93 { return delimiter_close(state, 3, offset); }
    return state;
}

fn delimiter_string_byte(state: [u64; 1024], value: byte) -> (result: [u64; 1024]) {
    if state[1] == 1 {
        return replace(state, 1, 0);
    }
    if value == 92 {
        return replace(state, 1, 1);
    }
    if value == 34 {
        return replace(state, 0, 0);
    }
    return state;
}

fn delimiter_block_comment_byte(state: [u64; 1024], value: byte) -> (result: [u64; 1024]) {
    if state[3] == 1 {
        if value == 47 {
            let clear_star: [u64; 1024] = replace(state, 3, 0);
            return replace(clear_star, 0, 0);
        }
        if value == 42 {
            return state;
        }
        return replace(state, 3, 0);
    }
    if value == 42 {
        return replace(state, 3, 1);
    }
    return state;
}

fn delimiter_byte(state: [u64; 1024], value: byte) -> (result: [u64; 1024]) {
    if state[5] != 0 {
        return state;
    }
    let offset: u64 = state[7];
    let advanced: [u64; 1024] = replace(state, 7, offset +% 1);
    if advanced[0] == 1 {
        return delimiter_string_byte(advanced, value);
    }
    if advanced[0] == 2 {
        if value == 10 { return replace(advanced, 0, 0); }
        return advanced;
    }
    if advanced[0] == 3 {
        return delimiter_block_comment_byte(advanced, value);
    }
    if advanced[2] == 1 {
        let clear_slash: [u64; 1024] = replace(advanced, 2, 0);
        if value == 47 { return replace(clear_slash, 0, 2); }
        if value == 42 { return replace(clear_slash, 0, 3); }
        return delimiter_normal_byte(clear_slash, value, offset);
    }
    return delimiter_normal_byte(advanced, value, offset);
}

fn delimiter_feed(bytes: [byte; up_to 64], state: [u64; 1024]) -> (result: [u64; 1024]) {
    iterate i over bytes carrying next_state: [u64; 1024] = state {
        next next_state = delimiter_byte(next_state, bytes[i]);
    }
    return next_state;
}

fn delimiter_finish(state: [u64; 1024]) -> (result: DelimiterResult) {
    if state[5] == 2 {
        return DelimiterResult { status: DelimiterStatus.CapacityExceeded, offset: state[6] };
    }
    if state[5] == 1 {
        return DelimiterResult { status: DelimiterStatus.Unbalanced, offset: state[6] };
    }
    if state[4] == 0 {
        return DelimiterResult { status: DelimiterStatus.Balanced, offset: 0 };
    }
    let slot: u64 = 8 + state[4] - 1;
    let packed: u64 = state[slot];
    return DelimiterResult { status: DelimiterStatus.Unbalanced, offset: packed / 4 };
}
