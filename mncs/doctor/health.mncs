mncs 0.16;
module doctor.health.v1;

// doctor.health — health-status aggregation policy in MNCS.
//
// Counts and bounded window lengths remain numeric observations. Semantic
// statuses and severities are nominal finite values, so the host cannot
// silently reinterpret a status code after this module evolves.

enum Status { Pass, Warning, Fail, Skipped }
enum Severity { Info, Warning, Error }
enum HealthCheckKind {
    SourceParseHealth,
    HeaderHealth,
    VersionDrift,
    NewlineEncoding,
    ManifestHealth,
    ToolchainHealth,
    LanguageKnowledge,
    MigrationAvailability
}

record EncodingFacts {
    valid_utf8: bool,
    has_bom: bool,
    mixed_newlines: bool
}

record CheckStatusInput {
    error_count: u64,
    warning_count: u64
}

record CheckStatusWithSkipInput {
    check: HealthCheckKind,
    error_count: u64,
    warning_count: u64,
    info_count: u64,
    skipped: bool
}

record OverallInput {
    statuses: [Status; 8],
    count: u64
}

// The host supplies scanner and decoder observations. MNCS decides whether
// each observation is an actionable health finding and its severity. Info
// means no finding for that dimension.
fn encoding_severities(input: EncodingFacts) -> (result: [Severity; 3]) {
    let utf8: Severity = match input.valid_utf8 {
        true => Severity.Info,
        false => Severity.Error,
    };
    let bom: Severity = match input.has_bom {
        true => Severity.Warning,
        false => Severity.Info,
    };
    let newlines: Severity = match input.mixed_newlines {
        true => Severity.Warning,
        false => Severity.Info,
    };
    return [utf8, bom, newlines];
}

fn is_fail(status: Status) -> (result: bool) {
    return match status {
        Pass => false,
        Warning => false,
        Fail => true,
        Skipped => false,
    };
}

fn is_warning(status: Status) -> (result: bool) {
    return match status {
        Pass => false,
        Warning => true,
        Fail => false,
        Skipped => false,
    };
}

fn is_pass(status: Status) -> (result: bool) {
    return match status {
        Pass => true,
        Warning => false,
        Fail => false,
        Skipped => false,
    };
}

// Combine two check statuses. Fail dominates, then warning; skipped
// yields to any decided status.
fn combine(a: Status, b: Status) -> (result: Status) {
    if is_fail(a) || is_fail(b) {
        return Status.Fail;
    }
    if is_warning(a) || is_warning(b) {
        return Status.Warning;
    }
    if is_pass(a) || is_pass(b) {
        return Status.Pass;
    }
    return Status.Skipped;
}

// Check status from finding counts: any error fails, else any warning
// warns, else pass. Infos never affect the verdict.
fn check_status(input: CheckStatusInput) -> (result: Status) {
    if input.error_count > 0 {
        return Status.Fail;
    }
    if input.warning_count > 0 {
        return Status.Warning;
    }
    return Status.Pass;
}

// Version drift remains actionable even though its file diagnostics are
// informational. The check identity and promotion rule stay native; the host
// supplies only collected severity counts and whether the check was skipped.
fn promotes_info(check: HealthCheckKind) -> (result: bool) {
    return match check {
        SourceParseHealth => false,
        HeaderHealth => false,
        VersionDrift => true,
        NewlineEncoding => false,
        ManifestHealth => false,
        ToolchainHealth => false,
        LanguageKnowledge => false,
        MigrationAvailability => false,
    };
}

// Findings still dominate a skipped check; only version-drift promotes
// informational findings to a warning.
fn check_status_with_skip(input: CheckStatusWithSkipInput) -> (result: Status) {
    if input.error_count > 0 {
        return Status.Fail;
    }
    if input.warning_count > 0 {
        return Status.Warning;
    }
    if promotes_info(input.check) && input.info_count > 0 {
        return Status.Warning;
    }
    if input.skipped {
        return Status.Skipped;
    }
    return Status.Pass;
}

// Overall status over a fixed window of check statuses plus a live count.
// The tail beyond count is never observed, so callers pack any number of
// checks into the window. The fold starts at pass, matching the reference:
// an empty check set is vacuously healthy (individual skips still fold
// through combine, which treats skipped as neutral).
fn overall(input: OverallInput) -> (result: Status) {
    iterate i over input.statuses carrying acc: Status = Status.Pass {
        let live: bool = i < input.count && i < input.statuses.len;
        next acc = select(live, combine(acc, input.statuses[i]), acc);
    }
    return acc;
}

// Severity passthrough keeps the native nominal type at the boundary.
fn rank(severity: Severity) -> (result: Severity) {
    return severity;
}
