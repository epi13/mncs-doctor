mncs 0.16;
module doctor.discovery.v1;

// doctor.discovery — classification policy over host directory-entry facts.
//
// The host still performs recursive enumeration, metadata acquisition, path
// joining, cycle identity, and byte reads. Compact name/extension codes are
// the transport because arbitrary strings and path values are not yet a
// bounded MNCS boundary. This module decides what those facts mean.

// Directory name codes 1..17 are the known tool/cache exclusions; 0 is an
// ordinary name. The finite result makes the policy independent of numeric
// discriminants at the host boundary.
enum DirectoryDecision { Descend, SkipDepth, SkipExcluded, SkipCycle, SkipSymlink }

record DirectoryDecisionInput {
    name_code: u64,
    extra_excluded: bool,
    is_symlink: bool,
    follow_symlink: bool,
    cycle: bool,
    depth: u64,
    max_depth: u64,
}

fn directory_decision(input: DirectoryDecisionInput) -> (result: DirectoryDecision) {
    if input.depth > input.max_depth {
        return DirectoryDecision.SkipDepth;
    }
    if !input.is_symlink && (input.extra_excluded || (input.name_code >= 1 && input.name_code <= 17)) {
        return DirectoryDecision.SkipExcluded;
    }
    if input.is_symlink && input.cycle {
        return DirectoryDecision.SkipCycle;
    }
    if input.is_symlink && !input.follow_symlink {
        return DirectoryDecision.SkipSymlink;
    }
    return DirectoryDecision.Descend;
}

// File name codes: 1=Forge TOML, 2=workspace TOML, 3=Cargo TOML,
// 4=*.mncs.json. Extension code 1 is `.mncs`.
enum FileClass { Ignore, Source, ForgeManifest, WorkspaceManifest, ManifestJson, Cargo }

record FileClassInput {
    name_code: u64,
    extension_code: u64,
}

fn file_class(input: FileClassInput) -> (result: FileClass) {
    if input.name_code == 1 {
        return FileClass.ForgeManifest;
    }
    if input.name_code == 2 {
        return FileClass.WorkspaceManifest;
    }
    if input.name_code == 3 {
        return FileClass.Cargo;
    }
    if input.name_code == 4 {
        return FileClass.ManifestJson;
    }
    if input.extension_code == 1 {
        return FileClass.Source;
    }
    return FileClass.Ignore;
}
