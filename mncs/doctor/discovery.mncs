mncs 0.16;
module doctor.discovery.v1;

// doctor.discovery — classification policy over host directory-entry facts.
//
// The host still performs recursive enumeration, metadata acquisition, path
// joining, cycle identity, and byte reads. Names and extensions cross this
// boundary as nominal finite values so the host cannot silently invent or
// renumber semantic classifications. This module decides what those facts
// mean.

enum DirectoryName {
    Other,
    Git,
    Hg,
    Svn,
    Target,
    NodeModules,
    Venv,
    Pycache,
    PytestCache,
    RuffCache,
    MypyCache,
    Dist,
    Worktrees,
    Tox,
    Idea,
    Vscode,
    AtlasJoernBaseline,
    DotVenv,
}
enum DirectoryDecision { Descend, SkipDepth, SkipExcluded, SkipCycle, SkipSymlink }

record DirectoryDecisionInput {
    name: DirectoryName,
    extra_excluded: bool,
    is_symlink: bool,
    follow_symlink: bool,
    cycle: bool,
    depth: u64,
    max_depth: u64,
}

fn excluded_directory_name(name: DirectoryName) -> (result: bool) {
    return match name {
        DirectoryName.Other => false,
        DirectoryName.Git => true,
        DirectoryName.Hg => true,
        DirectoryName.Svn => true,
        DirectoryName.Target => true,
        DirectoryName.NodeModules => true,
        DirectoryName.Venv => true,
        DirectoryName.Pycache => true,
        DirectoryName.PytestCache => true,
        DirectoryName.RuffCache => true,
        DirectoryName.MypyCache => true,
        DirectoryName.Dist => true,
        DirectoryName.Worktrees => true,
        DirectoryName.Tox => true,
        DirectoryName.Idea => true,
        DirectoryName.Vscode => true,
        DirectoryName.AtlasJoernBaseline => true,
        DirectoryName.DotVenv => true,
    };
}

fn directory_decision(input: DirectoryDecisionInput) -> (result: DirectoryDecision) {
    if input.depth > input.max_depth {
        return DirectoryDecision.SkipDepth;
    }
    if !input.is_symlink && (input.extra_excluded || excluded_directory_name(input.name)) {
        return DirectoryDecision.SkipExcluded;
    }
    if input.is_symlink && input.cycle {
        return DirectoryDecision.SkipCycle;
    }
    if input.is_symlink && !input.follow_symlink {
        return DirectoryDecision.SkipSymlink;
    }
    return DirectoryDecision.Descend;
}

enum FileName { Other, ForgeManifest, WorkspaceManifest, Cargo, ManifestJson }
enum FileExtension { Other, Mncs }
enum FileClass { Ignore, Source, ForgeManifest, WorkspaceManifest, ManifestJson, Cargo }

record FileClassInput {
    name: FileName,
    extension: FileExtension,
}

fn file_class(input: FileClassInput) -> (result: FileClass) {
    return match input.name {
        FileName.ForgeManifest => FileClass.ForgeManifest,
        FileName.WorkspaceManifest => FileClass.WorkspaceManifest,
        FileName.Cargo => FileClass.Cargo,
        FileName.ManifestJson => FileClass.ManifestJson,
        FileName.Other => match input.extension {
            FileExtension.Mncs => FileClass.Source,
            FileExtension.Other => FileClass.Ignore,
        },
    };
}
