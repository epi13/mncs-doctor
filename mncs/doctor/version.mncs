mncs 0.16;
module doctor.version.v1;

use mncs.std.text_utf8.v1 as text_utf8;

// doctor.version — language-version policy in MNCS.
//
// Boundary: the profile registry data (which versions exist and which is
// current) remains host-loaded knowledge (DOC-P-007). This module owns
// streamed X.Y text parsing and reasoning over parsed scalar values. Fixed
// byte chunks keep the native buffer bounded without limiting accepted text.
// Edge whitespace uses the shared Stdlib Unicode White_Space classifier.
// The host passes the current profile only to classification.
//
// Typed contract: version coordinates remain natural numeric data, while the
// classification result is a nominal finite value. Generated host bindings
// carry the record and enum identities across the embedded session.
//   compare returns -1/0/1 (left relative to right).
//   plan_span returns the edge count from->to, -1 for downgrades,
//     -2 when either endpoint is off the known 0.x line.

enum VersionClass { Current, Sealed, Unsupported, Unknown }

record VersionInput {
    major: i64,
    minor: i64,
    current_major: i64,
    current_minor: i64,
}

record VersionText16 { bytes: [byte; 16], length: u64 }

record VersionText64 { bytes: [byte; 64], length: u64 }

record VersionParseResult { valid: bool, major: u64, minor: u64 }

record VersionParseState {
    position: u64,
    phase: u64,
    major: u64,
    minor: u64,
    major_digits: bool,
    minor_digits: bool,
    failed: bool,
}

record DecimalStep { value: u64, valid: bool }

// Append one ASCII decimal digit while preserving the Rust u32 parse limit.
fn append_decimal(value: u64, scalar: u32) -> (result: DecimalStep) {
    let digit: u64 = (scalar as u64) - 48;
    if value > 429496729 || (value == 429496729 && digit > 5) {
        return DecimalStep { value: value, valid: false };
    }
    return DecimalStep { value: value * 10 + digit, valid: true };
}

// Consume one Unicode scalar per live byte lane. The phase machine preserves
// Rust's trimming around the whole value and each dot-separated component,
// permits its optional leading `+`, and rejects signs or junk elsewhere.
fn parse_version_step<N: Nat>(input: [byte; up_to N], input_length: u64, state: VersionParseState, lane: u64) -> (result: VersionParseState) {
    if state.failed || lane < state.position || lane >= input_length {
        return state;
    }
    let decoded: text_utf8.ScalarStep = text_utf8.step_scalar_generic<N>(
        input, input_length, state.position
    );
    if !decoded.valid {
        return VersionParseState { ..state, position: state.position + 1, failed: true };
    }
    let scalar: u64 = decoded.scalar as u64;
    let whitespace: bool = text_utf8.is_whitespace_scalar(decoded.scalar);
    let digit: bool = scalar >= 48 && scalar <= 57;
    if state.phase == 0 {
        if whitespace {
            return VersionParseState { ..state, position: decoded.next };
        }
        if scalar == 43 {
            return VersionParseState { ..state, position: decoded.next, phase: 1 };
        }
        if digit {
            let appended: DecimalStep = append_decimal(0, decoded.scalar);
            return VersionParseState { ..state, position: decoded.next, phase: 2,
                major: appended.value, major_digits: true, failed: !appended.valid };
        }
        return VersionParseState { ..state, position: decoded.next, failed: true };
    }
    if state.phase == 1 {
        if digit {
            let appended: DecimalStep = append_decimal(state.major, decoded.scalar);
            return VersionParseState { ..state, position: decoded.next, phase: 2,
                major: appended.value, major_digits: true, failed: !appended.valid };
        }
        return VersionParseState { ..state, position: decoded.next, failed: true };
    }
    if state.phase == 2 {
        if digit {
            let appended: DecimalStep = append_decimal(state.major, decoded.scalar);
            return VersionParseState { ..state, position: decoded.next,
                major: appended.value, failed: !appended.valid };
        }
        if whitespace {
            return VersionParseState { ..state, position: decoded.next, phase: 3 };
        }
        if scalar == 46 {
            return VersionParseState { ..state, position: decoded.next, phase: 4 };
        }
        return VersionParseState { ..state, position: decoded.next, failed: true };
    }
    if state.phase == 3 {
        if whitespace {
            return VersionParseState { ..state, position: decoded.next };
        }
        if scalar == 46 {
            return VersionParseState { ..state, position: decoded.next, phase: 4 };
        }
        return VersionParseState { ..state, position: decoded.next, failed: true };
    }
    if state.phase == 4 {
        if whitespace {
            return VersionParseState { ..state, position: decoded.next };
        }
        if scalar == 43 {
            return VersionParseState { ..state, position: decoded.next, phase: 5 };
        }
        if digit {
            let appended: DecimalStep = append_decimal(0, decoded.scalar);
            return VersionParseState { ..state, position: decoded.next, phase: 6,
                minor: appended.value, minor_digits: true, failed: !appended.valid };
        }
        return VersionParseState { ..state, position: decoded.next, failed: true };
    }
    if state.phase == 5 {
        if digit {
            let appended: DecimalStep = append_decimal(state.minor, decoded.scalar);
            return VersionParseState { ..state, position: decoded.next, phase: 6,
                minor: appended.value, minor_digits: true, failed: !appended.valid };
        }
        return VersionParseState { ..state, position: decoded.next, failed: true };
    }
    if state.phase == 6 {
        if digit {
            let appended: DecimalStep = append_decimal(state.minor, decoded.scalar);
            return VersionParseState { ..state, position: decoded.next,
                minor: appended.value, failed: !appended.valid };
        }
        if whitespace {
            return VersionParseState { ..state, position: decoded.next, phase: 7 };
        }
        return VersionParseState { ..state, position: decoded.next, failed: true };
    }
    if state.phase == 7 && whitespace {
        return VersionParseState { ..state, position: decoded.next };
    }
    return VersionParseState { ..state, position: decoded.next, failed: true };
}

// Parse one UTF-8-boundary-aligned chunk while carrying the native grammar
// state across chunks. An invalid oversized chunk fails closed.
fn parse_chunk_generic<N: Nat>(input: [byte; up_to N], input_length: u64, initial: VersionParseState) -> (result: VersionParseState) {
    if input_length > input.len {
        return VersionParseState { ..initial, position: 0, failed: true };
    }
    iterate lane over input carrying state: VersionParseState = initial {
        next state = parse_version_step<N>(input, input_length, state, lane);
    }
    return VersionParseState { ..state, position: 0 };
}

fn parse_chunk16(input: VersionText16, initial: VersionParseState) -> (result: VersionParseState) {
    let view: [byte; up_to 16] = input.bytes[0..16];
    return parse_chunk_generic<16>(view, input.length, initial);
}

fn parse_chunk64(input: VersionText64, initial: VersionParseState) -> (result: VersionParseState) {
    let view: [byte; up_to 64] = input.bytes[0..64];
    return parse_chunk_generic<64>(view, input.length, initial);
}

// Finalize after all chunks. Decimal bounds and syntax were decided in the
// native state machine; the host only converts the returned u32 coordinates.
fn finish_parse(state: VersionParseState) -> (result: VersionParseResult) {
    let valid: bool = !state.failed && state.major_digits && state.minor_digits
        && (state.phase == 6 || state.phase == 7);
    return VersionParseResult { valid: valid, major: state.major, minor: state.minor };
}

// Total order on (major, minor) pairs. No subtraction anywhere.
fn compare(a_major: i64, a_minor: i64, b_major: i64, b_minor: i64) -> (result: i64) {
    if a_major < b_major {
        return 0 - 1;
    }
    if a_major > b_major {
        return 1;
    }
    if a_minor < b_minor {
        return 0 - 1;
    }
    if a_minor > b_minor {
        return 1;
    }
    return 0;
}

// Classification against an explicitly supplied current profile.
// cur_major/cur_minor arrive from the host registry; nothing here names
// a current version.
fn classify(input: VersionInput) -> (result: VersionClass) {
    if input.major == input.current_major && input.minor == input.current_minor {
        return VersionClass.Current;
    }
    // Reserved/unsupported line: 1.0 is known but rejected upstream.
    if input.major == 1 && input.minor == 0 {
        return VersionClass.Unsupported;
    }
    // Sealed line: 0.x strictly below current, minor at least 1.
    if input.major == 0 && input.current_major == 0 && input.minor >= 1 && input.minor < input.current_minor {
        return VersionClass.Sealed;
    }
    return VersionClass.Unknown;
}

// True exactly for versions the toolchain accepts (current or sealed).
fn is_supported(class: VersionClass) -> (result: bool) {
    return match class {
        Current => true,
        Sealed => true,
        Unsupported => false,
        Unknown => false,
    };
}

// Migration span over the linear 0.x chain: edge count from->to.
// Downgrades refuse (-1); endpoints off the 0.x line refuse (-2).
// The chain needs no graph search: every real profile edge is adjacent.
fn plan_span(from_major: i64, from_minor: i64, to_major: i64, to_minor: i64) -> (result: i64) {
    if from_major != 0 || to_major != 0 {
        return 0 - 2;
    }
    if from_minor < 1 || to_minor < 1 {
        return 0 - 2;
    }
    let order: i64 = compare(from_major, from_minor, to_major, to_minor);
    if order == 0 {
        return 0;
    }
    if order > 0 {
        return 0 - 1;
    }
    return to_minor - from_minor;
}
