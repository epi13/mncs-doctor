mncs 0.16;
module doctor.version.v1;

// doctor.version — language-version policy in MNCS.
//
// Boundary: the profile *registry data* (which versions exist, which is
// current) is host-loaded knowledge (DOC-P-007). This module encodes the
// *reasoning rules* over versions supplied as plain scalars, so no registry
// table is mirrored here: the caller passes the current profile in, and
// classification follows the sealed-line rule (0.x with 1 <= minor <
// current is sealed). Comparison is total and uses no arithmetic on the
// compared values, so no overflow obligation can arise.
//
// Typed contract: version coordinates remain natural numeric data, while the
// classification result is a nominal finite value. Generated host bindings
// carry the record and enum identities across the embedded session.
//   compare returns -1/0/1 (left relative to right).
//   plan_span returns the edge count from->to, -1 for downgrades,
//     -2 when either endpoint is off the known 0.x line.

enum VersionClass { Current, Sealed, Unsupported, Unknown }

record VersionInput {
    major: i64,
    minor: i64,
    current_major: i64,
    current_minor: i64,
}

// Total order on (major, minor) pairs. No subtraction anywhere.
fn compare(a_major: i64, a_minor: i64, b_major: i64, b_minor: i64) -> (result: i64) {
    if a_major < b_major {
        return 0 - 1;
    }
    if a_major > b_major {
        return 1;
    }
    if a_minor < b_minor {
        return 0 - 1;
    }
    if a_minor > b_minor {
        return 1;
    }
    return 0;
}

// Classification against an explicitly supplied current profile.
// cur_major/cur_minor arrive from the host registry; nothing here names
// a current version.
fn classify(input: VersionInput) -> (result: VersionClass) {
    if input.major == input.current_major && input.minor == input.current_minor {
        return VersionClass.Current;
    }
    // Reserved/unsupported line: 1.0 is known but rejected upstream.
    if input.major == 1 && input.minor == 0 {
        return VersionClass.Unsupported;
    }
    // Sealed line: 0.x strictly below current, minor at least 1.
    if input.major == 0 && input.current_major == 0 && input.minor >= 1 && input.minor < input.current_minor {
        return VersionClass.Sealed;
    }
    return VersionClass.Unknown;
}

// True exactly for versions the toolchain accepts (current or sealed).
fn is_supported(class: VersionClass) -> (result: bool) {
    return match class {
        Current => true,
        Sealed => true,
        Unsupported => false,
        Unknown => false,
    };
}

// Migration span over the linear 0.x chain: edge count from->to.
// Downgrades refuse (-1); endpoints off the 0.x line refuse (-2).
// The chain needs no graph search: every real profile edge is adjacent.
fn plan_span(from_major: i64, from_minor: i64, to_major: i64, to_minor: i64) -> (result: i64) {
    if from_major != 0 || to_major != 0 {
        return 0 - 2;
    }
    if from_minor < 1 || to_minor < 1 {
        return 0 - 2;
    }
    let order: i64 = compare(from_major, from_minor, to_major, to_minor);
    if order == 0 {
        return 0;
    }
    if order > 0 {
        return 0 - 1;
    }
    return to_minor - from_minor;
}
