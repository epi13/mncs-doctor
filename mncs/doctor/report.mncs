mncs 0.16;
module doctor.report.v1;

// doctor.report — exit/status *policy* in MNCS.
//
// Human rendering and JSON encoding remain host-side. The policy boundary
// uses the health module's nominal Status type and returns a nominal exit
// decision rather than an undocumented process-code integer.

use doctor.health.v1 as health;

enum ExitDecision { Healthy, Findings, ReviewRequired, VerificationFailed }

record ExitInput {
    worst: health.Status,
    review_blocked: bool,
    verified: bool,
    verify_passed: bool
}

fn is_healthy(status: health.Status) -> (result: bool) {
    return match status {
        Pass => true,
        Warning => false,
        Fail => false,
        Skipped => true,
    };
}

// Exit policy: verification failure dominates; then review-blocked
// warnings/failures; then plain findings; pass and skipped stay healthy.
fn exit_for(input: ExitInput) -> (result: ExitDecision) {
    if input.verified && !input.verify_passed {
        return ExitDecision.VerificationFailed;
    }
    if is_healthy(input.worst) {
        return ExitDecision.Healthy;
    }
    if input.review_blocked {
        return ExitDecision.ReviewRequired;
    }
    return ExitDecision.Findings;
}
