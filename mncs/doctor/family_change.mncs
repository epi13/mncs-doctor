mncs 0.18;
module doctor.family_change.v1;
use mncs.commons.family.change.v1 as change;

// Doctor owns the remediation entrypoint; Commons supplies shared family law.
// Environment supplies observations/claims and performs two-phase revalidation.
fn gate_repair(class: u64, preimage: u64, generation: u64, claim: u64,
               dirt: u64, attempts: u64, budget: u64) -> (result: change.Gate) {
    return change.gate_repair(class, preimage, generation, claim, dirt, attempts, budget);
}
fn transform_admit(op: u64, preimage: u64, authority: u64,
                   bounded: u64, confined: u64) -> (result: change.TransformVerdict) {
    return change.transform_admit(op, preimage, authority, bounded, confined);
}
