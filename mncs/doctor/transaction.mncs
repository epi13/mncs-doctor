mncs 0.16;
module doctor.transaction.v1;

// doctor.transaction — mutation decision policy in MNCS.
//
// The host supplies filesystem facts (existence, symlink identity, regular
// file kind, and independently computed fingerprints). This module decides
// whether those facts permit a staged operation. It never performs a write,
// rename, chmod, or rollback: those remain narrow host mechanisms.
//
enum TransactionTargetVerdict { Allow, Identical, Symlink, Stale, NonFile }

record TransactionTargetInput {
    expected_present: bool,
    actual_present: bool,
    is_symlink: bool,
    is_file: bool,
    fingerprint_matches: bool,
    identical: bool,
}

fn validate_target(input: TransactionTargetInput) -> (result: TransactionTargetVerdict) {
    if input.is_symlink {
        return TransactionTargetVerdict.Symlink;
    }
    if input.expected_present {
        if !input.actual_present {
            return TransactionTargetVerdict.Stale;
        }
        if !input.is_file {
            return TransactionTargetVerdict.NonFile;
        }
        if !input.fingerprint_matches {
            return TransactionTargetVerdict.Stale;
        }
        if input.identical {
            return TransactionTargetVerdict.Identical;
        }
        return TransactionTargetVerdict.Allow;
    }
    if input.actual_present {
        return TransactionTargetVerdict.Stale;
    }
    return TransactionTargetVerdict.Allow;
}
